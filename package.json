{
  "name": "@bobcgn/skill-central",
  "version": "1.0.0-alpha.2",
  "private": true,
  "description": "Local MCP Server for cross-IDE AI skill distribution and reuse",
  "author": "BobcGn",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "skill-central": "dist/index.js"
  },
  "files": [
    "dist/",
    "dist/web/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BobcGn/skill-central.git"
  },
  "homepage": "https://github.com/BobcGn/skill-central#readme",
  "bugs": {
    "url": "https://github.com/BobcGn/skill-central/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "skills",
    "prompts",
    "cursor",
    "windsurf",
    "claude"
  ],
  "license": "MIT",
  "scripts": {
    "dev:mcp": "tsx watch src/index.ts mcp",
    "dev:board": "tsx src/index.ts board",
    "dev:desktop": "npm run build:desktop && electron dist/desktop/main.js",
    "dev:init": "tsx src/index.ts init",
    "dev:web": "tsx watch src/index.ts board",
    "build": "tsc && node scripts/copy-assets.mjs capabilities",
    "build:web": "node scripts/copy-assets.mjs web",
    "prebuild:desktop": "node scripts/generate-macos-icon.mjs",
    "build:desktop": "npm run build && npm run build:web",
    "homebrew:candidate": "node scripts/prepare-homebrew-candidate.mjs",
    "homebrew:diagnose": "node scripts/diagnose-homebrew-macos.mjs",
    "lint": "tsc --noEmit",
    "package:mac": "npm run build:desktop && node scripts/package-desktop.mjs mac",
    "package:win": "npm run build:desktop && node scripts/package-desktop.mjs win",
    "test:registry-perf": "node scripts/test-registry-performance.mjs",
    "test:asset-scope": "node scripts/test-asset-scope.mjs",
    "test:reverse-output": "node scripts/test-reverse-output.mjs",
    "test:auth:mac": "npm run build && node scripts/validate-macos-github-auth.mjs",
    "test:keychain:mac": "npm run build && node scripts/validate-macos-keychain.mjs",
    "pretest": "npm run build && npm run build:web",
    "test": "bash scripts/test.sh",
    "start": "node dist/index.js mcp"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@modelcontextprotocol/sdk": "^1.9.0",
    "commander": "^14.0.3",
    "electron-updater": "^6.8.9",
    "hono": "^4.12.25",
    "js-yaml": "^4.1.1",
    "smol-toml": "^1.7.1",
    "tar-stream": "^3.2.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.7",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
